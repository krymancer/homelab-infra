# Copy this to terraform.tfvars and fill in your values
# terraform.tfvars is gitignored — never commit it

# --- pve (Dell G15, 192.168.0.10) ---
# proxmox_api_url defaults to https://192.168.0.10:8006
proxmox_api_token_id     = "terraform@pam!terraform"
proxmox_api_token_secret = "your-token-secret-here"

# --- alt (standalone host, 192.168.0.11) ---
# proxmox_alt_api_url defaults to https://192.168.0.11:8006
# Leave the alt token vars empty to reuse proxmox_api_token_* (same id/secret
# string). Prefer creating a matching terraform@pam!terraform token on alt.
# proxmox_alt_api_token_id     = "terraform@pam!terraform"
# proxmox_alt_api_token_secret = "your-alt-token-secret-here"

ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIF7Q95691WXu2MwzknbezIzUMNuL7bd8cP9sGfe5u+Ec "

ci_password = "*vBsHTU13$YfBvU^f5x4YT3m"

k3s_vm = {
  vmid    = 200
  name    = "k3s"
  cores   = 4
  memory  = 8192
  disk    = "40G"
  storage = "local-lvm"   # check your Proxmox storage name
  ip      = "192.168.0.20/24"
  gateway = "192.168.0.1" # your router IP
}

# Tailscale pre-auth key. Create one-off at:
#   https://login.tailscale.com/admin/settings/keys
# Recommended: reusable=false, ephemeral=false, expiry 24h, tag:dev
tailscale_auth_key = "tskey-auth-XXXXXXXXXXXX"

hermes_lxc = {
  vmid     = 210
  name     = "hermes"
  cores    = 2
  memory   = 2048
  disk     = "16G"
  storage  = "ssd" # zfspool on alt
  ip       = "192.168.0.22/24"
  gateway  = "192.168.0.1"
  # On alt, confirm exact filename: `pveam list local`
  # Download if missing: `pveam update && pveam download local debian-13-standard`
  template = "local:vztmpl/debian-13-standard_13.1-2_amd64.tar.zst"
}
