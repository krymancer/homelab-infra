# Copy this to terraform.tfvars and fill in your values
# terraform.tfvars is gitignored — never commit it

# --- alt (standalone Proxmox host, 192.168.0.11) ---
# proxmox_api_url defaults to https://192.168.0.11:8006
proxmox_api_token_id     = "terraform@pam!terraform"
proxmox_api_token_secret = "your-token-secret-here"

ssh_public_key = "ssh-ed25519 AAAA... you@host"

ci_password = "change-me"

# k3s VM 220 on alt. Runs the whole cluster on 192.168.0.20.
# From scratch: set bootstrap = true and apply twice (guests + k3s, then Helm
# Argo). Keep it false against the live guests.
bootstrap = false
# Optional GitHub PAT for Argo (private repos / rate limits). Leave empty if public.
# argocd_git_token = "github_pat_XXXXXXXX"
k3s_vm = {
  vmid     = 220
  name     = "k3s"
  cores    = 8
  memory   = 16384 # 16 GiB ceiling (qm memory)
  balloon  = 16384 # balloon floor (qm balloon); live VM runs with no ballooning
  disk     = "120G"
  storage  = "ssd"
  ip       = "192.168.0.20/24"
  gateway  = "192.168.0.1"
  template = 9000
}

# Tailscale pre-auth key. Create one-off at:
#   https://login.tailscale.com/admin/settings/keys
# Recommended: reusable=false, ephemeral=false, expiry 24h, tag:dev
tailscale_auth_key = "tskey-auth-XXXXXXXXXXXX"

hermes_lxc = {
  vmid     = 210
  name     = "hermes"
  cores    = 2
  memory   = 4096
  disk     = "16G"
  storage  = "ssd" # zfspool on alt
  ip       = "192.168.0.22/24"
  gateway  = "192.168.0.1"
  # On alt, confirm exact filename: `pveam list local`
  # Download if missing: `pveam update && pveam download local debian-13-standard`
  template = "local:vztmpl/debian-13-standard_13.1-2_amd64.tar.zst"
}

# GPU passthrough VM on alt. Off by default (no mappings, no VM).
# After VFIO host prep (see terraform/README.md) and RAM headroom check:
#   1. enable_gpu_vm = true   → creates a STOPPED VM + PCI mappings
#   2. gpu_vm_started = true  → only when you are ready to boot it
enable_gpu_vm  = false
gpu_vm_started = false

