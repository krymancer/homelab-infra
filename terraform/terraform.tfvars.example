# Copy this to terraform.tfvars and fill in your values
# terraform.tfvars is gitignored — never commit it

# --- pve (Dell G15, 192.168.0.10) ---
# proxmox_api_url defaults to https://192.168.0.10:8006
proxmox_api_token_id     = "terraform@pam!terraform"
proxmox_api_token_secret = "your-token-secret-here"

# --- alt (standalone host, 192.168.0.11) ---
# Create a *separate* token on alt; do not reuse the pve secret.
# proxmox_alt_api_url defaults to https://192.168.0.11:8006
proxmox_alt_api_token_id     = "terraform@pam!terraform"
proxmox_alt_api_token_secret = "your-alt-token-secret-here"

# Future k3s/dev migration is a tfvars change. Keep these on pve for now.
# k3s_node_name = "pve"
# dev_node_name = "pve"
# alt_node_name = "alt"

ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIF7Q95691WXu2MwzknbezIzUMNuL7bd8cP9sGfe5u+Ec "

ci_password = "*vBsHTU13$YfBvU^f5x4YT3m"

k3s_vm = {
  vmid    = 200
  name    = "k3s"
  cores   = 4
  memory  = 8192
  disk    = "40G"
  storage = "local-lvm"   # check your Proxmox storage name
  ip      = "192.168.0.20/24"
  gateway = "192.168.0.1" # your router IP
}

# Tailscale pre-auth key. Create one-off at:
#   https://login.tailscale.com/admin/settings/keys
# Recommended: reusable=false, ephemeral=false, expiry 24h, tag:dev
tailscale_auth_key = "tskey-auth-XXXXXXXXXXXX"

dev_lxc = {
  vmid     = 201
  name     = "dev"
  cores    = 8
  memory   = 8192
  disk     = "90G"
  storage  = "local-lvm"
  ip       = "192.168.0.21/24"
  gateway  = "192.168.0.1"
  # Run `pveam list local` on PVE to confirm exact filename.
  # Download if missing: `pveam update && pveam download local archlinux-base_20260420-1_amd64.tar.zst`
  template = "local:vztmpl/archlinux-base_20260420-1_amd64.tar.zst"
}

# GPU passthrough VM on alt. Leave disabled while alt has 8 GiB RAM.
# After the 32 GiB upgrade (~25 Sep–5 Oct 2026):
#   1. Finish VFIO host prep on alt (see terraform/README.md)
#   2. enable_gpu_vm = true   → creates a STOPPED VM + PCI mappings
#   3. gpu_vm_started = true  → only when you are ready to boot it
# Pi-hole/DNS stay on the G15 until then.
enable_gpu_vm  = false
gpu_vm_started = false

# gpu_vm = {
#   vmid    = 300
#   name    = "gpu"
#   cores   = 4
#   memory  = 8192   # will OOM the current 8 GiB host if started
#   disk    = "64G"
